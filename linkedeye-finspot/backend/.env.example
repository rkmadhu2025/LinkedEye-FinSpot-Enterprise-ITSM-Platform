# LinkedEye-FinSpot Backend - Production Environment
# ================================================
# IMPORTANT: Replace placeholder values before deployment

# Server Configuration
NODE_ENV=production
PORT=5000
API_VERSION=v1

# Database - PostgreSQL (Kubernetes Service)
DB_HOST=postgresql-leadmin-service.postgresql-leadmin.svc.cluster.local
DB_PORT=5432
DB_NAME=linkedeye_finspot
DB_USER=root
DB_PASSWORD=Fin@spot!leadmin
DATABASE_URL=postgresql://root:Fin@spot!leadmin@postgresql-leadmin-service.postgresql-leadmin.svc.cluster.local:5432/linkedeye_finspot

# JWT Authentication (CHANGE IN PRODUCTION!)
JWT_SECRET=linkedeye-jwt-secret-production-2024-secure-key
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=linkedeye-refresh-secret-production-2024-secure-key
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=https://fs-le-dev-inc.finspot.in

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis Cache (Optional)
REDIS_URL=redis://redis-service.linkedeye-cache.svc.cluster.local:6379

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@finspot.in

# External Integrations (Optional)
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

JIRA_BASE_URL=
JIRA_USER=
JIRA_API_TOKEN=

SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=

# Monitoring
PROMETHEUS_URL=http://prometheus-service.linkedeye-monitoring.svc.cluster.local:9090
GRAFANA_URL=http://grafana-service.linkedeye-monitoring.svc.cluster.local:3000
