# Twilio Credentials Secret
# Copy this file to twilio-secret.yaml and fill in your actual credentials
# NEVER commit twilio-secret.yaml to git!
#
# Create the secret with:
#   kubectl create secret generic twilio-credentials \
#     --from-literal=account_sid=YOUR_ACCOUNT_SID \
#     --from-literal=auth_token=YOUR_AUTH_TOKEN \
#     --from-literal=from_number=YOUR_PHONE_NUMBER \
#     --from-literal=api_key_sid=YOUR_API_KEY_SID \
#     --from-literal=api_key_secret=YOUR_API_KEY_SECRET \
#     --namespace=linkedeye-itsm
#
# Or apply this file after editing:
#   kubectl apply -f twilio-secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: twilio-credentials
  namespace: linkedeye-itsm
type: Opaque
stringData:
  account_sid: "YOUR_TWILIO_ACCOUNT_SID"
  auth_token: "YOUR_TWILIO_AUTH_TOKEN"
  from_number: "YOUR_TWILIO_PHONE_NUMBER"
  api_key_sid: "YOUR_TWILIO_API_KEY_SID"  # Optional
  api_key_secret: "YOUR_TWILIO_API_KEY_SECRET"  # Optional
