# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/itsm_platform
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=itsm_platform
DATABASE_USER=username
DATABASE_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Configuration
APP_NAME=ITSM Platform
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring Configuration
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# AI Provider Configuration
# Option 1: Anthropic Claude (recommended)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest

# Option 2: OpenRouter (supports multiple models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Option 3: Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_API_KEY=

# Twilio Configuration (for SMS and Voice notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15625742095
TWILIO_DEFAULT_NOTIFICATION_PHONE=
TWILIO_ENABLED=true

# Voice Assistant Configuration
# Public URL for Twilio callbacks (use ngrok for local testing: ngrok http 8000)
VOICE_WEBHOOK_BASE_URL=https://your-domain.com
VOICE_CALL_TIMEOUT=30
VOICE_MAX_RETRIES=3
VOICE_RETRY_DELAY=300
# Comma-separated priorities that trigger automatic voice calls
VOICE_AUTO_CALL_PRIORITIES=critical,high